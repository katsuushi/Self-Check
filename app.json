{
  "expo": {
    "name": "SelfCheck",
    "slug": "selfcheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "selfcheck",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000",
        "foregroundImage": "./assets/images/adaptive-icon.png",
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.katsuu.selfcheck"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000",
          "image": "./assets/images/adaptive-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "976f0e74-e29b-4ba8-8f8c-7c7c8cf988da"
      }
    },
    "owner": "seg_fault"
  }
}
